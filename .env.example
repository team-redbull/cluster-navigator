# Server settings for running by hand. The Helm chart sets these for you.
# The full list, with defaults, is in backend/navigator/server/settings.py.

MONGO_URI=mongodb://localhost:27017
DB_NAME=cluster-navigator

# Required. Collectors send this as a bearer token. Use: openssl rand -hex 32
INGEST_TOKEN=

# Placeholders: {name}, {domain}, {clusterId}
GRAFANA_URL_TEMPLATE=

# openshift | dev | none
AUTH_PROVIDER=dev
ADMIN_GROUPS=ocp-admins
DEV_USERS={"admin": {"password": "admin", "groups": ["ocp-admins"]}}
SESSION_SECRET=
COOKIE_SECURE=false
